    body: "\u0412\u044B \u0431\u043E\u0438\u0442\u0435\u0441\u044C \u0442\u0435\u043C\u043D\u043E\u0442\u044B. \u0427\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C \u043D\u043E\u0447\u044C, \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C \u043D\u0430 \u0441\u0432\u0435\u0442\u0443, \u043F\u043E\u043A\u0430 \u0447\u0430\u0441\u044B \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0443\u0442 06:00."
  - image: {fileID: 2800000, guid: 362af5c6989e8634eaeb379f1d8996fb, type: 3}
    title: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0432\u0440\u0435\u043C\u044F \u0438\u0434\u0451\u0442 \u043D\u0430\u0437\u0430\u0434"
    body: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u0441\u0432\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0447\u0430\u0441\u044B \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0448\u043B\u0438 \u0432\u043F\u0435\u0440\u0451\u0434."
  - image: {fileID: 2800000, guid: b134c034a2e4234438eb86b12d401e75, type: 3}
    title: "\u041A\u043E\u0433\u0434\u0430 \u0433\u0430\u0441\u043D\u0435\u0442 \u0441\u0432\u0435\u0442"
    body: "\u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u043B\u0430\u043C\u043F\u044B \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0434\u043E\u043C\u0443. \u0415\u0441\u043B\u0438 \u0438\u0445 \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E, \u0447\u0430\u0441\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F."
  - image: {fileID: 2800000, guid: 853586059416d5a408415fc3dcfae51b, type: 3}
    title: "\u041D\u0430 \u0441\u0432\u0435\u0442\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E"
    body: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442. \u041D\u0430 \u0441\u0432\u0435\u0442\u0443 \u0432\u044B \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
  - image: {fileID: 2800000, guid: b5ce54c81b6c73d44a25723e36ce8338, type: 3}
    title: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435 \u0441\u0432\u0435\u0442"
    body: "\u041F\u043E\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u0441 \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0430\u043C\u0438. \u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041B\u041A\u041C, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0440\u0430\u0437\u0431\u0438\u0442\u0443\u044E \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0443, \u0437\u0430\u0442\u0435\u043C \u0437\u0430\u0436\u043C\u0438\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u043D\u043E\u0432\u0443\u044E."
