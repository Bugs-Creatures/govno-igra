#ifndef COTTAGE_SHADOW_SAMPLING_INCLUDED
#define COTTAGE_SHADOW_SAMPLING_INCLUDED

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/RealtimeLights.hlsl"

TEXTURE2D_ARRAY(_CottageShadowDepth);
SAMPLER(sampler_CottageShadowDepth);
float _CottageShadowLampCount;

// The face axes match the rays generated by CottageShadowBaker.
float3 CottageShadowCoords(float3 ray, uint lamp)
{
    float3 axis = abs(ray);
    float2 plane;
    float major;
    uint face;
    if (axis.x >= max(axis.y, axis.z))
    {
        face = ray.x >= 0 ? 0 : 1;
        plane = float2(ray.x >= 0 ? -ray.z : ray.z, ray.y);
        major = axis.x;
    }
    else if (axis.y >= axis.z)
    {
        face = ray.y >= 0 ? 2 : 3;
        plane = float2(ray.x, ray.y >= 0 ? -ray.z : ray.z);
        major = axis.y;
    }
    else
    {
        face = ray.z >= 0 ? 4 : 5;
        plane = float2(ray.z >= 0 ? ray.x : -ray.x, ray.y);
        major = axis.z;
    }
    return float3(plane * (0.5 / max(major, 0.0001)) + 0.5, lamp * 6 + face);
}

Light GetCottageAdditionalLight(uint i, float3 positionWS)
{
    return GetAdditionalLight(i, positionWS);
}

Light GetCottageAdditionalLight(uint i, InputData inputData, half4 shadowMask, AmbientOcclusionFactor aoFactor)
{
    Light light = GetAdditionalLight(i, inputData, shadowMask, aoFactor);
#if defined(_LIGHT_LAYERS) && !defined(_RECEIVE_SHADOWS_OFF)
    // Zero is reserved for lights that do not have a baked depth map.
    uint lamp = ((light.layerMask >> 2) & 15u) - 1u;
    UNITY_BRANCH
    if (lamp < (uint)_CottageShadowLampCount && light.distanceAttenuation > 0 &&
        light.shadowAttenuation > 0 && dot(inputData.normalWS, light.direction) > 0)
    {
#if USE_CLUSTER_LIGHT_LOOP
        int lightIndex = int(i);
#else
        int lightIndex = GetPerObjectLightIndex(i);
#endif
#if USE_STRUCTURED_BUFFER_FOR_LIGHT_DATA
        float3 lightPosition = _AdditionalLightsBuffer[lightIndex].position.xyz;
#else
        float3 lightPosition = _AdditionalLightsPosition[lightIndex].xyz;
#endif
        float3 ray = inputData.positionWS - lightPosition;
        float distanceToLight = length(ray);
        // Offset off the receiving surface and allow for the angular size of a texel.
        float bias = 0.012 + distanceToLight * 0.008;
        float3 coords = CottageShadowCoords(ray + inputData.normalWS * bias, lamp);
        float blocker = SAMPLE_TEXTURE2D_ARRAY_LOD(_CottageShadowDepth, sampler_CottageShadowDepth,
                                                   coords.xy, coords.z, 0).r;
        half bakedShadow = smoothstep(distanceToLight - bias * 2, distanceToLight - bias, blocker);
        light.shadowAttenuation = min(light.shadowAttenuation, bakedShadow);
    }
#endif
    return light;
}

// Leave the URP BRDF, light loops, and real-time shadow sampling intact.
#define GetAdditionalLight GetCottageAdditionalLight

#endif
